<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #1a0000; color: #ffffff; font-family: 'Noto Sans KR', sans-serif; }
    .hero-section {
      background: linear-gradient(rgba(26, 0, 0, 0.6), rgba(26, 0, 0, 0.9)), url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=1000') center/cover;
      padding: 40px 20px; text-align: center; border-bottom: 4px solid #ff3333;
    }
    h1, h2, h3 { color: #ff3333; text-shadow: 2px 2px 4px #000000; font-weight: bold; }
    .card { background-color: #2b0505; border: 1px solid #ff3333; color: white; margin-bottom: 20px; }
    .nav-tabs .nav-link { color: #ccc; }
    .nav-tabs .nav-link.active { background-color: #ff3333; color: white; border-color: #ff3333; }
    .btn-danger { background-color: #cc0000; border: none; }
    .btn-danger:hover { background-color: #ff3333; }
    .badge-score { background-color: #ff3333; font-size: 1rem; }
    .loading-text { color: #ff3333; font-style: italic; }
    .table-schedule { color: white; background-color: #2b0505; }
    .table-schedule th { color: #ff3333; border-bottom: 2px solid #ff3333; }
    .table-schedule td { border-bottom: 1px solid #441111; }
  </style>
</head>
<body>

  <div class="hero-section">
    <h1>🔥 대~한민국! 붉은 악마 스코어 예측 🔥</h1>
    <p class="lead text-warning">⚽ 제1경기: 대한민국 🇰🇷 vs 체코 🇨🇿</p>
  </div>

  <div class="container mt-4">
    <ul class="nav nav-tabs mb-4" id="predictTab" role="tablist">
      <li class="nav-item"><button class="nav-link active" id="bet-tab" data-bs-toggle="tab" data-bs-target="#bet">🎯 베팅하기</button></li>
      <li class="nav-item"><button class="nav-link" id="board-tab" data-bs-toggle="tab" data-bs-target="#board" onclick="loadData()">📊 결과 보기</button></li>
      <li class="nav-item"><button class="nav-link" id="my-tab" data-bs-toggle="tab" data-bs-target="#my" onclick="loadData()">🙋 나의 베팅 현황</button></li>
      <li class="nav-item"><button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule">📅 예선전 일정</button></li>
    </ul>

    <div class="tab-content" id="predictTabContent">
      <div class="tab-pane fade show active" id="bet">
        <div class="card p-4">
          <div class="mb-3">
            <label class="form-label fw-bold">1. 본인의 이름을 입력해주세요</label>
            <input type="text" id="userName" class="form-control" placeholder="홍길동">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">2. 예상 스코어 선택 (한국 득점, 체코 득점 순)</label>
            <div class="row">
              <div class="col">
                <select id="scoreKor" class="form-select"><option value="">대한민국 득점</option></select>
              </div>
              <div class="col">
                <select id="scoreCzech" class="form-select"><option value="">체코 득점</option></select>
              </div>
            </div>
          </div>
          <div class="alert alert-dark border-warning text-light mt-3">
            💰 <b>참가 안내:</b> 1베팅당 참가비는 <b>10,000원</b>입니다. (다른 스코어로 다중 베팅 가능)<br>
            🏦 <b>입금 계좌:</b> 기업은행 010-9023-0129 (예금주: 한재민)
          </div>
          <button id="submitBtn" class="btn btn-danger w-100 py-2 fw-bold" onclick="submitBetting()">🔥 대한민국 응원하며 베팅 제출</button>
        </div>
      </div>

      <div class="tab-pane fade" id="board">
        <h3 class="mb-3">💰 실시간 배당 현황</h3>
        <div class="alert alert-info" id="totalPoolBox">데이터를 동기화하는 중...</div>
        <div class="row">
          <div class="col-md-4">
            <h4 class="text-danger border-bottom pb-2">🇰🇷 대한민국 승리 스코어 파트</h4>
            <div id="korWinList" class="loading-text">불러오는 중...</div>
          </div>
          <div class="col-md-4">
            <h4 class="text-warning border-bottom pb-2">🤝 무승부 스코어 파트</h4>
            <div id="drawList" class="loading-text">불러오는 중...</div>
          </div>
          <div class="col-md-4">
            <h4 class="text-info border-bottom pb-2">🇨🇿 체코 승리 스코어 파트</h4>
            <div id="czechWinList" class="loading-text">불러오는 중...</div>
          </div>
        </div>
      </div>

      <div class="tab-pane fade" id="my">
        <h3>🙋 나의 예측 및 예상 배당금 검색</h3>
        <div class="input-group mb-3">
          <input type="text" id="searchName" class="form-control" placeholder="이름을 입력하세요">
          <button class="btn btn-danger" onclick="searchMyBet()">조회하기</button>
        </div>
        <div id="myResultList"></div>
      </div>

      <div class="tab-pane fade" id="schedule">
        <h3 class="mb-3">📅 대한민국 대표팀 조별 예선 경기 일정</h3>
        <div class="card p-4">
          <div class="table-responsive">
            <table class="table table-schedule text-center align-middle">
              <thead>
                <tr>
                  <th>매치</th>
                  <th>대진 내용</th>
                  <th>경기 일정 (한국 시간)</th>
                  <th>비고</th>
                </tr>
              </thead>
              <tbody>
                <tr class="fw-bold text-warning">
                  <td>제 1경기</td>
                  <td>대한민국 🇰🇷 vs 체코 🇨🇿</td>
                  <td>2026년 6월 12일 (금) 오전 11:00</td>
                  <td>현재 예측 진행 중!</td>
                </tr>
                <tr>
                  <td>제 2경기</td>
                  <td>대한민국 🇰🇷 vs 우루과이 🇺🇾</td>
                  <td>2026년 6월 16일 (화) 오전 09:30</td>
                  <td>-</td>
                </tr>
                <tr>
                  <td>제 3경기</td>
                  <td>대한민국 🇰🇷 vs 카메룬 🇨🇲</td>
                  <td>2026년 6월 21일 (일) 오전 11:00</td>
                  <td>-</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="alert alert-dark mt-2 border-danger text-muted" style="font-size: 0.85rem;">
            ※ 위 일정은 대회 공식 조직위원회 및 중계 사정에 따라 일부 변경될 수 있습니다.
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // [업데이트 완료] 새로 제공해주신 최종 URL을 연동했습니다.
    const APP_URL = "https://script.google.com/macros/s/AKfycbxrU-d4yEDnIusd9R9E4xWA3tmL0TG1vOjI6V68oBjMd33TC1nFlG5ntgh1n2hmWxLA/exec";

    const scoreKor = document.getElementById('scoreKor');
    const scoreCzech = document.getElementById('scoreCzech');
    for(let i=0; i<=9; i++) {
      scoreKor.options.add(new Option(i + "점", i));
      scoreCzech.options.add(new Option(i + "점", i));
    }

    let globalData = [];

    window.onload = function() {
      loadData();
    };

    function loadData() {
      google.script.run.withSuccessHandler(function(data) {
        globalData = data;
        renderBoard();
      }).getDashboardData();
    }

    function submitBetting() {
      const name = document.getElementById('userName').value.trim();
      const sk = scoreKor.value;
      const sc = scoreCzech.value;

      if(!name || sk === "" || sc === "") {
        alert("이름과 예상 스코어를 모두 선택해주세요!");
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.innerText = "⏳ 베팅 등록 중...";

      google.script.run.withSuccessHandler(function(res) {
        alert(res.message);
        btn.disabled = false;
        btn.innerText = "🔥 대한민국 응원하며 베팅 제출";
        if(res.success) {
          document.getElementById('userName').value = '';
          scoreKor.value = "";
          scoreCzech.value = "";
          loadData();
        }
      }).submitBet(name, sk, sc);
    }

    function renderBoard() {
      let totalPool = globalData.reduce((acc, row) => acc + (Number(row['입금확인']) === 10000 ? 10000 : 0), 0);
      document.getElementById('totalPoolBox').innerHTML = `<h3>🔥 현재 입금확정 총 판돈: ${totalPool.toLocaleString()}원</h3>`;

      let scoreCounts = {};
      globalData.forEach(row => {
        if(Number(row['입금확인']) === 10000) {
          let scoreKey = row['한국점수'] + ":" + row['체코점수'];
          scoreCounts[scoreKey] = (scoreCounts[scoreKey] || 0) + 1;
        }
      });

      let groups = { korWin: {}, draw: {}, czechWin: {} };

      globalData.forEach(row => {
        let k = Number(row['한국점수']);
        let c = Number(row['체코점수']);
        let scoreKey = k + ":" + c;
        
        let part = (k > c) ? 'korWin' : ((k === c) ? 'draw' : 'czechWin');
        if(!groups[part][scoreKey]) groups[part][scoreKey] = [];
        
        let statusText = Number(row['입금확인']) === 10000 ? `<span class='text-success fw-bold'>(확정)</span>` : `<span class='text-muted'>(대기)</span>`;
        groups[part][scoreKey].push(row['성명'] + statusText);
      });

      const generateHtml = (partGroup) => {
        let html = '';
        for(let score in partGroup) {
          let confirmedCount = scoreCounts[score] || 0;
          let dividend = confirmedCount > 0 ? Math.floor(totalPool / confirmedCount) : 0;
          html += `<div class='card p-3 mb-2'>
            <div class='mb-1'>⚽ <b>[${score}] 스코어</b></div>
            <div class='text-light mb-2' style='font-size:0.9rem;'>배팅: ${partGroup[score].join(', ')}</div>
            <div class='text-warning fw-bold' style='font-size:0.85rem;'>🎯 적중 시 예상 배당금: ${dividend.toLocaleString()}원</div>
          </div>`;
        }
        return html;
      };

      document.getElementById('korWinList').innerHTML = generateHtml(groups.korWin) || '<p class="text-muted">베팅 내역이 없습니다.</p>';
      document.getElementById('drawList').innerHTML = generateHtml(groups.draw) || '<p class="text-muted">베팅 내역이 없습니다.</p>';
      document.getElementById('czechWinList').innerHTML = generateHtml(groups.czechWin) || '<p class="text-muted">베팅 내역이 없습니다.</p>';
    }

    function searchMyBet() {
      const sName = document.getElementById('searchName').value.trim();
      if(!sName) {
        alert("이름을 입력해주세요!");
        return;
      }
      
      let totalPool = globalData.reduce((acc, row) => acc + (Number(row['입금확인']) === 10000 ? 10000 : 0), 0);
      let scoreCounts = {};
      globalData.forEach(row => {
        if(Number(row['입금확인']) === 10000) {
          let scoreKey = row['한국점수'] + ":" + row['체코점수'];
          scoreCounts[scoreKey] = (scoreCounts[scoreKey] || 0) + 1;
        }
      });

      let myRows = globalData.filter(row => row['성명'] === sName);
      let html = '';
      
      if(myRows.length === 0) {
        html = '<p class="text-danger mt-2">입력하신 이름으로 참여한 내역이 없습니다.</p>';
      } else {
        myRows.forEach(row => {
          let isPaid = Number(row['입금확인']) === 10000;
          let status = isPaid ? "<span class='text-success fw-bold'>✅ 입금 확인 완료</span>" : "<span class='text-warning fw-bold'>⏳ 입금 확인 대기 중 (미반영)</span>";
          let scoreKey = row['한국점수'] + ":" + row['체코점수'];
          let count = scoreCounts[scoreKey] || 0;
          let dividend = (isPaid && count > 0) ? Math.floor(totalPool / count) : 0;
          
          html += `<div class='card p-3 mb-2'>
            <h5>예측 스코어: <span class='badge badge-score'>${scoreKey}</span></h5>
            <p class='mb-1'>결제 상태: ${status}</p>
            <p class='mb-0 text-warning'><b>적중 시 예상 수령액: ${dividend.toLocaleString()}원</b> <br><span class='text-muted' style='font-size:0.8rem;'>(현재 이 스코어에 베팅하고 입금이 완료된 인원: ${count}명)</span></p>
          </div>`;
        });
      }
      document.getElementById('myResultList').innerHTML = html;
    }
  </script>
</body>
</html>
